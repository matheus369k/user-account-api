{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Node 22",
	"_version": "22.0.0",
	"compilerOptions": {
		"lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator"],
		"module": "nodenext",
		"target": "es2022",
		"strict": true,
		"noEmit": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"moduleResolution": "node16",
		"paths": {
			"@/*": ["./src/*"]
		},
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"include": ["generated", "src"],
	"exclude": ["node_modules", "build", "dist"],
	"ts-node": {
		"files": true
	}
}
